POSTGRES_PASSWORD=<database-password>
# Ít nhất 32 ký tự
JWT_SECRET=<random-string-at-least-32-characters>
ASSISTANT_INTERNAL_TOKEN=<random-shared-token>
# Mật khẩu chung của 4 tài khoản demo
DEMO_USER_PASSWORD=<demo-password>

# scripted = trả lời tất định, không cần API key.
# Model thật: ASSISTANT_LLM_PROVIDER=openai, ASSISTANT_LLM_MODEL=gpt-4.1-mini, OPENAI_API_KEY=...
ASSISTANT_LLM_PROVIDER=scripted
ASSISTANT_LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Chỉ cần khi gọi backend trực tiếp từ origin khác (ví dụ npm run dev); qua nginx là cùng origin.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
